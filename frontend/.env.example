# SAMJO frontend environment.
#
# Only variables prefixed VITE_ reach the browser, and everything here is
# public by definition. No key, secret or credential belongs in this file or
# in any .env under frontend/ — the Gemini key lives in the backend only.

# Where the browser sends API calls.
#
# Leave this UNSET for local development: vite.config.ts proxies /api to
# http://127.0.0.1:8000, which keeps the session cookie first-party and
# avoids SameSite problems. The app falls back to the relative path /api/v1.
#
# Set it for a deployed frontend, to the backend's public origin plus /api/v1:
#   VITE_API_BASE_URL=https://samjo-api.onrender.com/api/v1
#
# That origin must also appear in the backend's CORS_ALLOWED_ORIGINS, and the
# backend must be reachable over HTTPS, or the credentialed request is blocked.
VITE_API_BASE_URL=
