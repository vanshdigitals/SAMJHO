# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# ---- Database ----
# SQLite for dev and CI (foreign_keys=ON enforced); managed Postgres when deployed
DATABASE_URL=sqlite:///./samjo.db

# ---- Primary LLM Provider ----
# Options: mock | gemini | claude (OpenAI is NOT used per RESOURCE_AUDIT)
# One of: mock | groq | gemini | claude
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_THINKING_LEVEL=low
CHARACTERIZATION_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=1
# Required to be "true" if APP_ENV=production and LLM_PROVIDER=gemini, as Free tier trains on user data
GEMINI_BILLING_CONFIRMED=false

# ---- Groq (OpenAI-compatible, https://api.groq.com/openai/v1) ----
# Free tier: no card, no training on Inputs/Outputs (Services Agreement §4.2),
# zero data retention available self-serve in Console > Data Controls.
# Get a key at https://console.groq.com/keys — never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Fallback LLM Provider (Optional) ----
# Only used if primary fails with 429/5xx after bounded backoff. Leave empty to disable fallback.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=claude-sonnet-5
LLM_FALLBACK_API_KEY=

# ---- File Handling ----
MAX_UPLOAD_BYTES=10485760
MAX_PAGE_COUNT=30
MAX_EXTRACTION_CHARS=120000
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png
UPLOAD_TMP_DIR=./var/uploads

# ---- OCR ----
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.60
OCR_TIMEOUT_SECONDS=30
OCR_LANGUAGES=hin+eng
# TESSERACT_CMD= (optional: path to tesseract binary; auto-detected if empty)
# TESSDATA_PREFIX= (optional: path to tessdata folder; auto-detected if empty)

# ---- Retention ----
DOCUMENT_TTL_HOURS=24
SESSION_TTL_HOURS=72

# ---- Rate Limiting (enforced per session AND per IP) ----
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_ANALYSES_PER_HOUR=15
RATE_LIMIT_SITUATIONS_PER_HOUR=10
# Reserved for future Q&A endpoint (Conflict C3 - BLOCKED PENDING DECISION)
RATE_LIMIT_QUESTIONS_PER_HOUR=40

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=
# Fernet key! Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
